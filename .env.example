# --- LLM provider (bring your own key; pick one) ---
LLM_PROVIDER=anthropic        # anthropic | openai | gemini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Galileo (AI agent observability) — sign up at https://app.galileo.ai/sign-up ---
GALILEO_API_KEY=
GALILEO_PROJECT=ai-builders-workshop
GALILEO_LOG_STREAM=default

# --- Splunk MCP (provided by your workshop facilitator) ---
SPLUNK_MCP_URL=
SPLUNK_MCP_TOKEN=
SPLUNK_MCP_TRANSPORT=http      # http | sse | stdio — confirm exact value with facilitator
